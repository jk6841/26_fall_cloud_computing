{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Install",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Dev Server",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Backend: Test",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend: Check (Ruff)",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Install",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Dev Server",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Check (Biome)",
      "type": "shell",
      "command": "pnpm check",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": { "kind": "test", "isDefault": false },
      "problemMatcher": []
    },
    {
      "label": "Dev: Backend + Frontend",
      "dependsOn": ["Backend: Dev Server", "Frontend: Dev Server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
